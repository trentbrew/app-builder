# Bun sandbox server (optional — auto-detected by the client)
SANDBOX_SERVER_PORT=9899

# Local Ollama chat (SvelteKit /api/chat)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4

# Force a sandbox backend: bun | webcontainer (default: auto-detect on server)
# PUBLIC_SANDBOX_BACKEND=webcontainer
