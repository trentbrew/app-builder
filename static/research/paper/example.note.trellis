    {
      "id": "b-uiw1z7a",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "      \"content\": \"// Example: Loading a trellis file\\nconst graph "
        },
        {
          "type": "text",
          "text": "="
        },
        {
          "type": "text",
          "text": " await loadTrellis('example.note.trellis')\\nconst blocks "
        },
        {
          "type": "text",
          "text": "="
        },
        {
          "type": "text",
          "text": " graph"
        },
        {
          "type": "text",
          "text": "["
        },
        {
          "type": "text",
          "text": "'"
        },
        {
          "type": "text",
          "text": "@"
        },
        {
          "type": "text",
          "text": "graph'].sort((a, b) "
        },
        {
          "type": "text",
          "text": "="
        },
        {
          "type": "text",
          "text": "> a.position - b.position)\","
        }
      ]
    },
